#!/bin/sh

# ----------------------------------------------------------------------------
# commit-msg hook
#
# 1. Validate the commit message against the Conventional Commits spec
#    (optionally prefixed with a Jira key, e.g. "BET-9: feat(editor): ...").
# 2. Run lint + unit tests. End-to-end tests run only when Cypress is
#    installed and the dev site is reachable, so the hook stays usable
#    without a running environment.
# ----------------------------------------------------------------------------

commit_msg_file="$1"
commit_msg=$(cat "$commit_msg_file")

# --- Step 1: Conventional Commits validation -------------------------------
# Skip merge / fixup / squash / amend / revert commits.
if ! echo "$commit_msg" | grep -qE '^(Merge|fixup!|squash!|amend!|Revert) '; then

	# Format: [KEY-NNN: ]<type>[(scope)][!]: <description>
	pattern='^([A-Z]+-[0-9]+: )?(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-zA-Z0-9 _/.-]+\))?!?: .+'

	if ! echo "$commit_msg" | head -1 | grep -qE "$pattern"; then
		echo ""
		echo "ERROR: Commit message does not follow the Conventional Commits specification."
		echo ""
		echo "  Expected: [KEY-NNN: ]<type>[(scope)]: <description>"
		echo "  Types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert"
		echo ""
		echo "  Example: BET-9: feat(editor): dim disabled blocks on the canvas"
		echo ""
		echo "  Your message: $(head -1 "$commit_msg_file")"
		echo ""
		exit 1
	fi
fi

# --- Step 2: Lint (auto-fix + re-staging already happened in pre-commit) ----
if [ -f composer.json ] && [ -d vendor ]; then
	composer lint || exit 1
fi

# --- Step 3: PHP unit tests ------------------------------------------------
if [ -f composer.json ] && [ -d vendor ]; then
	composer test:unit:php || exit 1
fi

# --- Step 4: JS unit tests (skip if dependencies are not installed) ---------
if [ -d node_modules ]; then
	npm test -- --passWithNoTests || exit 1
fi

# --- Step 5: Cypress e2e (skip unless installed AND site reachable) ---------
# Base URL resolution order:
#   1. CYPRESS_BASE_URL env var (explicit override)
#   2. WP_ENV_PORT env var → http://localhost:${WP_ENV_PORT}
#   3. Default http://localhost:8888
# Use Chrome to avoid Electron memory-pressure crashes in headless mode.
if [ -d node_modules ] && npx --no-install cypress --version >/dev/null 2>&1; then
	if [ -n "$CYPRESS_BASE_URL" ]; then
		base_url="$CYPRESS_BASE_URL"
	elif [ -n "$WP_ENV_PORT" ]; then
		base_url="http://localhost:${WP_ENV_PORT}"
	else
		base_url="http://localhost:8888"
	fi
	if curl -sSf "$base_url" -o /dev/null 2>/dev/null; then
		CYPRESS_BASE_URL="$base_url" npx --no-install cypress run --browser chrome || exit 1
	else
		echo "Skipping Cypress e2e: $base_url not reachable."
	fi
fi
