{
	"name": "9ete/block-enable-toggle",
	"description": "Adds an Enabled toggle to every block. Disabled blocks stay in the editor but are never rendered on the front end.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"squizlabs/php_codesniffer": "^3.13",
		"wp-coding-standards/wpcs": "^3.1",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"phpunit/phpunit": "^11.5 || ^12.0"
	},
	"scripts": {
		"install-hooks": "git config core.hooksPath .githooks",
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"test": "phpunit",
		"test:unit:php": "phpunit",
		"test:unit:js": "npm test",
		"test:e2e": "npx --no-install cypress run",
		"build-zip": "./bin/build-zip.sh",
		"plugin-check": "wp-env run cli wp plugin activate block-enable-toggle && wp-env run cli wp plugin check block-enable-toggle",
		"check": [
			"@lint",
			"@test:unit:php",
			"@test:unit:js",
			"@test:e2e",
			"@plugin-check"
		]
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
